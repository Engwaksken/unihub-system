# Copy to .env (or configure these values in your hosting environment).
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.example

DB_HOST=127.0.0.1
DB_NAME=your_database
DB_USER=your_database_user
DB_PASS="replace-with-a-strong-unique-password"
DB_CHARSET=utf8mb4

# Optional: uncomment and configure to override email_settings table values.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=mailer@example.com
# SMTP_PASS="replace-with-a-secret"
# SMTP_SECURE=tls
# SMTP_FROM_EMAIL=mailer@example.com
# SMTP_FROM_NAME="Your Company"
